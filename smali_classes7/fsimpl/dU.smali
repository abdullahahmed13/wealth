.class public final Lfsimpl/dU;
.super Lfsimpl/gW;


# direct methods
.method public static a(Lfsimpl/gS;II)I
    .locals 2

    const/4 v0, 0x2

    const/4 v1, 0x4

    invoke-virtual {p0, v0, v1}, Lfsimpl/gS;->a(II)V

    int-to-short p2, p2

    invoke-virtual {p0, p2}, Lfsimpl/gS;->a(S)V

    int-to-short p1, p1

    invoke-virtual {p0, p1}, Lfsimpl/gS;->a(S)V

    invoke-virtual {p0}, Lfsimpl/gS;->a()I

    move-result p0

    return p0
.end method
