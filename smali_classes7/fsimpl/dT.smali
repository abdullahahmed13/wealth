.class public final Lfsimpl/dT;
.super Lfsimpl/gW;


# direct methods
.method public static a(Lfsimpl/gS;II)I
    .locals 2

    const/4 v0, 0x4

    const/16 v1, 0x8

    invoke-virtual {p0, v0, v1}, Lfsimpl/gS;->a(II)V

    invoke-virtual {p0, p2}, Lfsimpl/gS;->b(I)V

    invoke-virtual {p0, p1}, Lfsimpl/gS;->b(I)V

    invoke-virtual {p0}, Lfsimpl/gS;->a()I

    move-result p0

    return p0
.end method
