2\u0006\u0004\n\u0002\u0010\u0006R\u0010\u0010\u000b\u001a\u00020\u0005X\u0082\u0004\u00a2\u0006\u0004\n\u0002\u0010\u0006R\u0011\u0010\u000c\u001a\u00020\r\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u000e\u0010\u000fR\u0011\u0010\u0010\u001a\u00020\r\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008\u0011\u0010\u000fR\u001a\u0010\u0012\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008\u0013\u0010\u0003\u001a\u0004\u0008\u0014\u0010\u000fR\u001a\u0010\u0015\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008\u0016\u0010\u0003\u001a\u0004\u0008\u0017\u0010\u000fR\u001a\u0010\u001b\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008\u001c\u0010\u0003\u001a\u0004\u0008\u001d\u0010\u000fR\u001a\u0010\u001e\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008\u001f\u0010\u0003\u001a\u0004\u0008 \u0010\u000fR\u001a\u0010#\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008$\u0010\u0003\u001a\u0004\u0008%\u0010\u000fR\u001a\u0010&\u001a\u00020\r8FX\u0087\u0004\u00a2\u0006\u000c\u0012\u0004\u0008\'\u0010\u0003\u001a\u0004\u0008(\u0010\u000fR\u0010\u0010)\u001a\u00020\u0005X\u0082\u0004\u00a2\u0006\u0004\n\u0002\u0010\u0006R\u0011\u0010*\u001a\u00020\r\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008+\u0010\u000fR\u0010\u0010,\u001a\u00020\u0005X\u0082\u0004\u00a2\u0006\u0004\n\u0002\u0010\u0006R\u0011\u0010-\u001a\u00020\r\u00a2\u0006\u0008\n\u0000\u001a\u0004\u0008.\u0010\u000fR\u0013\u0010/\u001a\u00020\u0005\u00a2\u0006\n\n\u0002\u0010\u0006\u001a\u0004\u00080\u00101R\u0013\u00102\u001a\u00020\u0005\u00a2\u0006\n\n\u0002\u0010\u0006\u001a\u0004\u00083\u00101R\u001e\u00104\u001a\u00020\u00058\u0006X\u0087\u0004\u00a2\u0006\u0010\n\u0002\u0010\u0006\u0012\u0004\u00085\u0010\u0003\u001a\u0004\u00086\u00101R\u001e\u00107\u001a\u00020\u00058\u0006X\u0087\u0004\u00a2\u0006\u0010\n\u0002\u0010\u0006\u0012\u0004\u00088\u0010\u0003\u001a\u0004\u00089\u00101R\u001e\u0010:\u001a\u00020\u00058\u0006X\u0087\u0004\u00a2\u000